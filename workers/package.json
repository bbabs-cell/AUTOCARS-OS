{
  "name": "autocare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run && vitest run --config vitest.outils.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "types": "wrangler types",
    "deploy": "wrangler deploy",
    "test:workers": "vitest run",
    "test:outils": "vitest run --config vitest.outils.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
