# ==================================================================
# AUTOCARE OS — configuration Nginx de production
# ==================================================================
# À copier dans /etc/nginx/sites-available/autocare puis :
#
#   ln -s /etc/nginx/sites-available/autocare /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Remplacer PARTOUT :
#   app.ma-station.sn   par votre domaine
#   /var/www/autocare   par le chemin de déploiement
#
# ------------------------------------------------------------------
# UN SEUL DOMAINE POUR LES DEUX
#
# L'application Angular et l'API vivent sous le même nom, l'API sous
# /api. Ce n'est pas une coquetterie : deux domaines rendraient le
# cookie de session « tiers », et les navigateurs les bloquent de plus
# en plus. Avec un seul domaine, `SameSite=Strict` protège vraiment.
# ==================================================================


# ------------------------------------------------------------------
# 1. HTTP ne sert qu'à rediriger — et à renouveler le certificat
# ------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name app.ma-station.sn;

    # Let's Encrypt vérifie le domaine par un fichier servi en clair.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}


# ------------------------------------------------------------------
# 2. Le vrai serveur
# ------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name app.ma-station.sn;

    # ==============================================================
    # LA RACINE EST public/, JAMAIS LE DOSSIER DU PROJET.
    # ==============================================================
    # C'est LA erreur de déploiement à ne pas faire. Si la racine
    # pointait sur /var/www/autocare/backend, alors `.env` serait
    # téléchargeable : identifiants de la base et clé de signature des
    # jetons, en une requête. Le contrôle `php tools/preflight.php`
    # vérifie ce point.
    # C'est le dossier PUBLIE par deploy/deploy.sh, pas le dossier
    # source du frontend. Servir /var/www/autocare/frontend rendrait
    # `src/`, `package.json` et `node_modules/` telechargeables, et il
    # n'y aurait meme pas d'index.html a la racine : le site serait a
    # la fois casse et expose.
    root /var/www/autocare-web;
    index index.html;

    ssl_certificate     /etc/letsencrypt/live/app.ma-station.sn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.ma-station.sn/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # --------------------------------------------------------------
    # En-têtes de sécurité
    # --------------------------------------------------------------
    # Ils sont dans un fichier à part, et ce n'est pas de la coquetterie
    # d'organisation : nginx REMPLACE les `add_header` hérités dès
    # qu'un bloc en définit un seul. Trois `location` de ce fichier en
    # définissent un (le cache). Sans l'`include` répété dans chacun,
    # aucun en-tête de sécurité n'atteint le navigateur — c'est ce qui
    # se passait, et seul un `curl -I` sur le site l'a montré.
    #
    # Le détail de chaque en-tête est commenté dans le fichier inclus.
    include /etc/nginx/autocare-security-headers.conf;

    server_tokens off;

    # Les photos d'inspection font 12 Mo au maximum côté application.
    client_max_body_size 14M;

    # --------------------------------------------------------------
    # L'API
    # --------------------------------------------------------------
    # ==============================================================
    # TOUT /api PART DIRECTEMENT AU CONTRÔLEUR FRONTAL. C'EST VOULU.
    # ==============================================================
    # La version précédente de ce fichier faisait :
    #
    #     alias /var/www/autocare/backend/public;
    #     try_files $uri /index.php$is_args$args;
    #     location ~ \.php$ { ... }
    #
    # et AUCUNE route de l'API ne fonctionnait. C'est le piège nginx
    # le plus connu et le plus silencieux : dans un bloc qui utilise
    # `alias`, le repli de `try_files` est résolu depuis la RACINE DU
    # SITE, pas depuis l'alias. nginx cherchait donc `/index.php` dans
    # le build Angular, ne le trouvait pas, et la requête finissait
    # dans `location /` qui répond `index.html`. Un POST vers
    # /api/auth/login recevait « 405 Not Allowed », qui ne ressemble
    # en rien à la cause réelle.
    #
    # On supprime le piège au lieu de le contourner :
    #
    #   - `backend/public/` ne contient QUE index.php. Il n'y a aucun
    #     fichier statique à servir sous /api, donc `try_files` n'a
    #     rien à essayer et `alias` n'a rien à exposer.
    #   - Le routeur PHP lit `REQUEST_URI` tel quel (voir
    #     src/Core/Request.php) : le préfixe /api lui parvient intact,
    #     il n'y a rien à réécrire.
    #
    # Une ligne de moins, un piège de moins, et les routes marchent.
    location /api {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;

        # Le contrôleur frontal, en chemin absolu : il ne dépend ni de
        # la racine du site ni de l'URL demandée.
        fastcgi_param SCRIPT_FILENAME /var/www/autocare/backend/public/index.php;
        fastcgi_param SCRIPT_NAME     /api/index.php;

        # Le temps d'une restitution avec photos sur une connexion
        # lente. Au-delà, quelque chose ne va pas.
        fastcgi_read_timeout 60s;
    }

    # --------------------------------------------------------------
    # L'application Angular
    # --------------------------------------------------------------
    # Les fichiers compilés portent une empreinte dans leur nom
    # (main-A1B2C3.js) : ils ne changent jamais, on peut les garder un
    # an. `index.html`, lui, ne doit JAMAIS être mis en cache — c'est
    # lui qui désigne la version des autres.
    location ~* \.(?:js|css|woff2|png|jpg|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/autocare-security-headers.conf;
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/autocare-security-headers.conf;
    }

    # Toute autre URL rend index.html : c'est une application à page
    # unique, et le routeur d'Angular s'occupe du reste. C'est aussi ce
    # qui fait fonctionner la page 404 du lot 18 — le serveur ne sait
    # pas quelles routes existent, l'application si.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # --------------------------------------------------------------
    # Ce qui ne doit jamais sortir
    # --------------------------------------------------------------
    # Ceinture et bretelles : ces chemins ne sont déjà pas servis, mais
    # une erreur de configuration future ne doit pas les exposer.
    location ~ /\.(?!well-known) { deny all; }
    location ~ ^/(storage|vendor|tools|tests|database)/ { deny all; }

    access_log /var/log/nginx/autocare.access.log;
    error_log  /var/log/nginx/autocare.error.log;
}
