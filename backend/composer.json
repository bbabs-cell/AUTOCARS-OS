{
    "name": "autocare/backend",
    "description": "AUTOCARE OS - API REST (PHP 8.4, sans framework)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "firebase/php-jwt": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "Autocare\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public router.php",
        "check-db": "php tools/check_db.php",
        "lint": "php tools/lint.php",
        "migrate": "php tools/migrate.php",
        "seed": "php tools/seed.php",
        "test": "php tests/run_all.php",
        "benchmark": "php tools/benchmark.php",
        "benchmark-seed": "php tools/benchmark_seed.php",
        "preflight": "php tools/preflight.php",
        "backup": "php tools/backup.php",
        "restore": "php tools/restore.php"
    }
}
