# ==================================================================
# AUTOCARE OS — MODELE DE CONFIGURATION
# ==================================================================
#
# CE FICHIER EST UN MODELE. Il est suivi par Git et ne doit contenir
# AUCUN vrai mot de passe.
#
# Pour l'utiliser :
#   1. copie-le :   cp .env.example .env      (Windows : copy .env.example .env)
#   2. remplis .env avec tes vraies valeurs
#   3. ne commit JAMAIS le fichier .env (il est deja dans .gitignore)
#
# ==================================================================

# --- APPLICATION --------------------------------------------------

# local | production
APP_ENV=local

# true  : les messages d'erreur detailles sont affiches (developpement)
# false : OBLIGATOIRE en production, sinon tu exposes la structure
#         de ton code a tout internet
APP_DEBUG=true

# Adresse exacte du frontend Angular autorise a appeler l'API (CORS).
# En production : https://app.autocare-os.com
APP_FRONTEND_URL=http://localhost:4200


# --- BASE DE DONNEES MySQL ----------------------------------------

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autocare_os
DB_USER=root
DB_PASSWORD=


# --- SECURITE -----------------------------------------------------

# Cle secrete servant a signer les jetons d'authentification (Lot 4).
# Genere la tienne avec cette commande :
#
#     php -r "echo bin2hex(random_bytes(32));"
#
# Elle doit etre longue, aleatoire, et differente entre le
# developpement et la production. Si quelqu'un la connait, il peut
# fabriquer de faux jetons et se faire passer pour n'importe qui.
JWT_SECRET=

# Duree de validite du jeton d'acces, en minutes.
# Court volontairement : s'il est vole, il expire vite.
JWT_ACCESS_TTL_MINUTES=30

# Duree de validite du jeton de rafraichissement, en jours.
JWT_REFRESH_TTL_DAYS=7


# --- COURRIER -----------------------------------------------------

# Comment les messages partent (mot de passe oublié, confirmation de
# changement de mot de passe).
#
#   log   (défaut) écrit le message dans storage/logs/mail.log, sans
#         rien envoyer. C'est ce qu'il faut en développement : on
#         relit le lien de réinitialisation sans configurer quoi que
#         ce soit, et aucun message ne part par erreur vers l'adresse
#         réelle d'un client pendant un test.
#
#   mail  remet le message au serveur de courrier de la machine, via
#         la fonction mail() de PHP. C'est le transport de production
#         tant qu'aucun prestataire n'est choisi — décision attendue
#         au lot 22, avec l'hébergement.
#
# Un nom inconnu retombe sur « log » : mieux vaut un message écrit
# quelque part qu'une erreur au milieu d'une demande de mot de passe.
MAIL_DRIVER=log

# Adresse d'expédition. Elle doit appartenir à un domaine que le
# serveur a le droit d'utiliser, sinon les messages partiront dans
# les indésirables — quand ils partiront.
MAIL_FROM=no-reply@autocare-os.local
MAIL_FROM_NAME="AUTOCARE OS"
